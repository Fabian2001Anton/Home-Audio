{
  "manifest_version": 3,
  "name": "HeimAudio Tabs",
  "version": "1.0",
  "description": "Zeigt der HeimAudio-App auf dem iPhone die offenen Tabs und schließt sie auf Wunsch.",
  "key": "",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "hintergrund.js"
  },
  "icons": {
    "48": "symbol-48.png",
    "128": "symbol-128.png"
  },
  "minimum_chrome_version": "116"
}
